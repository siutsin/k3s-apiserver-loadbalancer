{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  automerge: true,
  major: {
    automerge: false,
  },
  minimumReleaseAge: '7 days',
  rebaseWhen: 'behind-base-branch',
  packageRules: [
    {
      matchPackageNames: ['dataaxiom/ghcr-cleanup-action'],
      abandonmentThreshold: null,
    },
    {
      matchPackageNames: ['*'],
      semanticCommitType: 'fix', // Dep updates ship as patches via release-please
    },
  ],
}
